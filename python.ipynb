   ],
   "source": [
    "# Even Numbers between 0 and 30\n",
    "\n",
    "even_num = []\n",
    "\n",
    "for num in range(31):\n",
    "    if num % 2 == 0:\n",
    "        even_num.append(num)\n",
    "\n",
    "print(f\"These are even numbers between 0 and 30: {even_num}\")"
   ]
